void print() // same
{
    node *t = head;

    if (head == 0)
    {
        cout << "List is empty!" << endl
             << endl;
        return;
    }

    cout << "Sorted Linked List: ";

    while (t != 0)
    {
        cout << t->data << " ";
        t = t->link;
    }

    cout << endl
         << endl;
}

void Delete(int pos)
{
    if (head == 0)
    {
        cout << "List is empty!" << endl
             << endl;
        return;
    }

    if (pos < 1)
    {
        cout << "Invalid position!" << endl
             << endl;
        return;
    }

    if (pos == 1)
    {
        node *t = head;
        head = t->link;
        delete t;

        cout << "Node deleted successfully" << endl
             << endl;
        cout << "After Deletion: " << endl;
        print();
        return;
    }

    node *t = head;
    node *prev;

    for (int i = 1; i < pos; i++)
    {
        prev = t;
        t = t->link;

        if (t == 0)
        {
            cout << "Invalid position!" << endl
                 << endl;
            return;
        }
    }

    prev->link = t->link;
    delete t;

    cout << "Node deleted successfully" << endl
         << endl;
    cout << "After Deletion: " << endl;
    print();
}

void search(int item) // same
{
    node *t = head;
    int pos = 1;

    while (t != 0)
    {
        if (t->data == item)
        {
            cout << "Item found!" << endl;
            cout << "Position: " << pos << endl
                 << endl;
            return;
        }

        t = t->link;
        pos++;
    }

    cout << "Item not found!" << endl
         << endl;
}

int main()
{

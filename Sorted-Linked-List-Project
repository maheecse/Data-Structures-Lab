        }
        else if (choice == 2)
        {
            cout << "Enter position: ";
            cin >> val;
            Delete(val);

            // cout << "After Deletion: " << endl;
            // print();
        }
        else if (choice == 3)
        {
            cout << "Enter value: ";
            cin >> val;

            search(val);

#include <bits/stdc++.h>
using namespace std;

struct node
{
    int data;
    node *link;
};

node *head = 0;

void insert(int val)
{
    node *temp = new node;
    temp->data = val;
    temp->link = 0;

    if (head == 0 || val < head->data)
    {
        temp->link = head;
        head = temp;
        return;
    }

    node *t = head;

    while (t->link != 0 && t->link->data < val)
    {
        t = t->link;
    }

    temp->link = t->link;
    t->link = temp;
}

